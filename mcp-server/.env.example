# Expense Tracker Backend API base URL
EXPENSE_API_BASE_URL=http://127.0.0.1:8000

# Optional static JWT Bearer Token (if you already have one)
EXPENSE_API_TOKEN=

# Optional credentials for automatic login & token retrieval
EXPENSE_API_EMAIL=user@example.com
EXPENSE_API_PASSWORD=password123

# Port for MCP Server in SSE Mode (Default: 8002 to prevent conflict with port 8000/8001)
MCP_SSE_PORT=8002

# Required when connecting from a remote client such as ChatGPT.
# Generate a long random value and do not commit the real value to source control.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
