{
  "name": "expense-tracker-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Server for the Expense Tracker API, supporting Cursor, Claude Desktop, and ChatGPT",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "expense-tracker-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "start:sse": "node dist/index.js --transport sse",
    "test": "node dist/test-server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude",
    "chatgpt",
    "expense-tracker",
    "finance"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
