# App Configuration
APP_NAME="Expense Tracker API"
DEBUG=false
LOG_LEVEL="INFO"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
USE_DATABASE=true
DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/expense_tracker"

# Authentication & Security
JWT_SECRET_KEY="generate-a-secure-random-32-character-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Settings (Optional, for Password Reset & OTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@finsight.local"
SMTP_FROM_NAME="FIN Expense Tracker"
SMTP_TLS=true
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Free LLM AI Chat & Query (Gemini / Groq / Ollama integration)
# GEMINI_API_KEY="your-free-gemini-api-key"
# GROQ_API_KEY="your-free-groq-api-key"
